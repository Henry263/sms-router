# --- Twilio (reuse from your Twilio account) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+14084131602
# Recommended for US deliverability + A2P 10DLC compliance (send OTP through your Messaging Service):
TWILIO_MESSAGING_SERVICE_SID=

# --- This service's own database (MongoDB Atlas) ---
MONGODB_URI=

# --- Public base URL of THIS service (used to validate Twilio's webhook signature) ---
PUBLIC_URL=https://sms-router.onrender.com

# --- One shared secret per app (generate each with: openssl rand -hex 32) ---
ROUTER_API_KEY_CONNECTIKO=
ROUTER_API_KEY_SCAN4FEEDBACK=
ROUTER_API_KEY_SCAN2REVIEWS=
ROUTER_API_KEY_SCANMYPRO=

# --- Optional per-app internal URL overrides (staging/testing) ---
# INTERNAL_URL_CONNECTIKO=https://stage.connectiko.io/internal/sms

# --- Daily send caps (rolling 24h). Defaults shown. ---
# SMS_MAX_PER_PHONE_PER_DAY=3
# SMS_MAX_PER_APP_PER_DAY=500
# SMS_OTP_MAX_PER_PHONE_PER_DAY=5

# --- Local only: record texts instead of sending them ---
# SMS_DRY_RUN=true

# --- Local only: skip Twilio signature checks when testing with curl ---
# SKIP_TWILIO_SIGNATURE=true

PORT=3000
